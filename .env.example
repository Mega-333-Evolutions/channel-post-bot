# --- Telegram -------------------------------------------------------------
API_ID=
API_HASH=
BOT_TOKEN=
# Numeric Telegram ids (ask @userinfobot). Owners can do everything, admins can only create/edit posts.
OWNER_IDS=
ADMIN_IDS=

# --- Database -------------------------------------------------------------
# PostgreSQL, e.g. a free Neon database. Leave empty to use a local SQLite file (data/bot.db).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# "null" = short-lived connections (lets serverless Postgres sleep); "queue" = normal pool for an always-on DB
DB_POOL=null

# --- Optional -------------------------------------------------------------
# Where the login session is kept. On hosts that wipe files on restart, run `python make_session.py`
# once and put the printed text in SESSION_STRING instead.
SESSION_PATH=data/bot
SESSION_STRING=
# Seconds between edits during /replace (Telegram rate limits: don't go much lower)
EDIT_DELAY=1.2
# Also swap links that are typed as plain text in a post (not only hyperlinks and buttons)
REPLACE_TYPED_LINKS=true
# Some free hosts need an open port: set it and the bot answers "ok" on /
PORT=
LOG_LEVEL=INFO
